{
  "info": {
    "_postman_id": "b7e1c2a4-9f30-4d6a-8c11-mensajeria02",
    "name": "Mensajeria RabbitMQ",
    "description": "Productor de mensajes. POST /messages publica en la cola durable messages_queue. status es booleano.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3020"
    }
  ],
  "item": [
    {
      "name": "1. Mensaje válido",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Content-Type JSON', function () {",
              "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
              "});",
              "",
              "pm.test('Mensaje encolado con status booleano', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json.status).to.eql(true);",
              "  pm.expect(json.message).to.eql('Mensaje encolado');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sensor\": \"OD-01\",\n  \"valor\": 4.2,\n  \"unidad\": \"mg/L\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/messages",
          "host": ["{{baseUrl}}"],
          "path": ["messages"]
        },
        "description": "Publica un mensaje válido. Para la evidencia de diez mensajes, abre el Collection Runner y ejecuta esta petición 10 veces."
      },
      "response": []
    },
    {
      "name": "2. Mensaje inválido",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400', function () {",
              "  pm.response.to.have.status(400);",
              "});",
              "",
              "pm.test('Content-Type JSON', function () {",
              "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
              "});",
              "",
              "pm.test('Formato inválido con status booleano', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json.status).to.eql(false);",
              "  pm.expect(json.message).to.eql('Formato de mensaje inválido');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{sensor: OD-01, valor: 4.2}",
          "options": {
            "raw": {
              "language": "text"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/messages",
          "host": ["{{baseUrl}}"],
          "path": ["messages"]
        },
        "description": "Cuerpo que no es JSON válido. No debe publicarse nada en la cola."
      },
      "response": []
    }
  ]
}
