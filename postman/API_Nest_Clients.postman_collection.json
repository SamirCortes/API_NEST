    "name": "API Nest - Clients",
    "description": "Colección de pruebas CRUD para la API de clientes (NestJS + MySQL).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3020"
    },
    {
      "key": "clientId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Clients",
      "item": [
        {
          "name": "1. Crear cliente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 or 201', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "pm.test('Respuesta exitosa', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.status).to.eql(true);",
                  "  pm.expect(json.data).to.have.property('id');",
                  "  pm.collectionVariables.set('clientId', json.data.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"names\": \"Ana\",\n  \"surnames\": \"Lopez\",\n  \"age\": 28,\n  \"status\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/clients",
              "host": ["{{baseUrl}}"],
              "path": ["clients"]
            },
            "description": "Crea un cliente. Guarda el id en la variable clientId."
          },
          "response": []
        },
        {
          "name": "2. Listar clientes",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Lista de registros', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.status).to.eql(true);",
                  "  pm.expect(json.data).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/clients",
              "host": ["{{baseUrl}}"],
              "path": ["clients"]
            },
            "description": "Lista todos los clientes."
          },
          "response": []
        },
        {
          "name": "3. Consultar cliente por id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Registro consultado', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.status).to.eql(true);",
                  "  pm.expect(json.message).to.eql('Registro consultado');",
                  "  pm.expect(json.data).to.have.property('id');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/clients/{{clientId}}",
              "host": ["{{baseUrl}}"],
              "path": ["clients", "{{clientId}}"]
            },
            "description": "Consulta un cliente por id (usa {{clientId}})."
          },
          "response": []
        },
        {
          "name": "4. Actualizar cliente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
