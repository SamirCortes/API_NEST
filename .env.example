# API local (Nest fuera de Docker)
PORT=3000
DB_HOST=localhost
DB_PORT=3307
DB_USERNAME=nest
DB_PASSWORD=nest
DB_DATABASE=api_nest

# RabbitMQ (local)
RABBITMQ_URL=amqp://nest:nest@localhost:5672
RABBITMQ_QUEUE=messages_queue

# OpenTelemetry hacia SigNoz (API local). En Docker el colector es otel-collector:4318.
OTEL_SERVICE_NAME=api-nest
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Nota: con `docker compose up` la API usa:
# DB_HOST=mysql, DB_PORT=3306, RABBITMQ_URL=amqp://nest:nest@rabbitmq:5672
